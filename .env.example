# ───────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사해 값을 채운다. (.env 는 커밋하지 않는다)
# Vercel 배포 시에는 같은 이름의 값을 Vercel 프로젝트 환경변수에 넣는다.
# 값을 구하는 절차는 README 의 "환경 설정" 절을 따른다.
# ───────────────────────────────────────────────────────────────

# ── 데이터베이스 (Supabase PostgreSQL) ──────────────────────────
# DATABASE_URL: 앱이 쓰는 풀드(pgbouncer) 연결. 포트 6543, 끝에 ?pgbouncer=true&connection_limit=1
# DIRECT_URL  : 마이그레이션 전용 다이렉트 연결. 포트 5432
#   (pgbouncer 의 transaction 모드는 마이그레이션이 필요로 하는 prepared statement /
#    advisory lock 을 지원하지 않아서 둘을 분리한다.)
# Supabase 대시보드 > Project Settings > Database > Connection string 에서 복사한다.
# 로컬 개발용 DB 를 쓸 때는 둘 다 같은 주소(예: postgresql://postgres:postgres@localhost:5433/ai_support)로 둔다.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── 인증 ────────────────────────────────────────────────────────
# 긴 무작위 문자열. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 이 이메일로 로그인하면 항상 관리자(ADMIN). 쉼표로 구분, 3명.
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# Google Cloud Console > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Google 콘솔의 "승인된 리디렉션 URI" 에 똑같이 등록해야 한다.
#   로컬:   http://localhost:4000/api/auth/google/callback
#   운영:   https://<프로젝트>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── 주소 ────────────────────────────────────────────────────────
# 로그인 후 브라우저를 돌려보낼 프런트 주소 (운영에서는 배포 도메인)
FRONTEND_URL=http://localhost:5173
# 로컬 개발에서 허용할 CORS 출처
CORS_ORIGIN=http://localhost:5173
PORT=4000

# ── 웹 푸시 (VAPID) ─────────────────────────────────────────────
# 생성: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ── 주기 작업 ───────────────────────────────────────────────────
# POST /api/cron/reminders 호출 시 "Authorization: Bearer <값>" 으로 보내는 공유 비밀.
CRON_SECRET=change-this-to-a-long-random-string

# ── 파일 저장 (Supabase Storage) — 첨부파일 ───────────────────────
# 비어 있으면 첨부파일 기능만 꺼지고(503 안내) 나머지는 정상 동작한다.
# Supabase > Project Settings > API 에서 복사한다.
# SERVICE_ROLE_KEY 는 서버에서만 쓰고 프런트에 절대 노출하지 않는다.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 첨부파일을 담는 버킷 이름. Supabase > Storage 에서 "비공개(Private)" 버킷으로 만들고,
# 버킷 설정의 "File size limit"을 10MB로 둔다(업로드 시점의 크기 제한은 저장소가 강제한다). README 참고.
SUPABASE_BUCKET=attachments

# ── 프런트엔드 (Vite) ───────────────────────────────────────────
# VITE_* 값은 이 파일이 아니라 frontend/.env 에 둔다. (frontend/.env.example 참고)
# 빌드 시점에 프런트 코드로 들어가므로 비밀값을 넣지 않는다.
