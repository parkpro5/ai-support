{
  "name": "ai-support-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mjs",
    "test:db:setup": "node scripts/setup-test-db.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@supabase/storage-js": "^2.119.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^9.14.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.20.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^2.1.9"
  }
}
